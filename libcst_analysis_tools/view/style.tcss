TreeComponent {
    width: auto;
    height: 100%;
}

DirectoryTreeComponent {
    width: 33%;
    min-width: 30;
    height: 100%;
}

/* Main layout: Horizontal split */
#main-layout {
    width: 100%;
    height: 100%;
}

/* LEFT PANEL: Environments (1/3) + Packages (2/3) */
#left-panel {
    width: 30%;
    height: 100%;
}

#environments-section {
    height: 33%;
    width: 100%;
}

#packages-section {
    height: 67%;
    width: 100%;
    border: solid $primary;
    border-title-align: left;
}

/* RIGHT PANEL: Trees (70%) + Log (30%) */
#right-panel {
    width: 1fr;
    height: 100%;
}

#trees-panel {
    height: 70%;
    width: 100%;
}

#trees-panel > DirectoryTreeComponent,
#trees-panel > TreeComponent {
    width: 33%;
    height: 100%;
}

#filesystem-tree {
    border: solid $primary;
    border-title-align: left;
}

#content-tree {
    border: solid $primary;
    border-title-align: left;
}

#callgraph-tree {
    border: solid $primary;
    border-title-align: left;
}

TableComponent {
    height: 100%;
    width: 1fr;        
    padding:0;
}

LogComponent {
    border: solid $primary;
    border-title-align: left;
    height: 30%;
    width: 100%;
}

DataTable {
    height: 100%;
}

EnvironmentsTableComponent {
    width: 100%;
    height: 100%;
}
